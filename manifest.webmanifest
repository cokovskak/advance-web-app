{
  "name": "Pentest Pipeline Dashboard",
  "short_name": "PentestPWA",
  "description": "Penetration test results from CI/CD pipelines, offline-ready.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b1220",
